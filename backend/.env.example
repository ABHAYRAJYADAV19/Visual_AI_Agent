# ==============================================================================
# Visual Activity AI Agent — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ==============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://vai_user:vai_local_password@localhost:5432/vai_db

# --- Object Storage (S3-compatible / MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=vai-screenshots

# --- Anthropic Claude API ---
# Required for AI annotation (Phase 4+). Leave blank for Phases 0-3.
ANTHROPIC_API_KEY=

# --- Data Retention ---
RETENTION_DAYS=30

# --- Rate Limiting ---
API_RATE_LIMIT=100

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
